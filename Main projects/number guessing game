def finish(number, count):
    print("End game")
    print(f"my number was {number} and you fund it in {count}")

    answer = input("Doyou want to play again? (Y/N)")
    if answer.upper() == "Y":
        return True
    else:
        return False


def win(computer_number, guess):
    return computer_number == guess


def answer(computer, user):
    if computer > user:
        return "my number is larger"
    if user > computer:
        return "my number is smaller"
    else:
        return "Woooo!! You won"


def get_a_guess():
    ans = input("What is your guess? ")
    return int(ans)


welcom()

