print("====== Magic Number Analyzer ======")

n = int(input("Enter a number: "))

print(f"\nNumber: {n}")
print(f"Divisible by 3: {n % 3 == 0}")
print(f"Divisible by 5: {n % 5 == 0}")

if n % 3 == 0 and n % 5 == 0:
    print("Result: Legendary ")
elif n % 3 == 0:
    print("Result: Magic ")
elif n % 5 == 0:
    print("Result: Cursed ")
else:
    print("Result: Normal")
