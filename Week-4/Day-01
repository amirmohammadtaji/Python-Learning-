donations = {
    "Jadi": 800,
    "Sara": 200,
    "Far": 12,
    "Hasan": 9
}


def donationa_analysis(don):
    person = ""
    total = 0
    count = 0
    max_donation = -1
    for name, value in don.items():
        total += value
        count += 1
        if value > max_donation:
            person = name
            max_donation = value

    avrage = int(total / count)
    return avrage, total, person


avg, total, max_person = donationa_analysis(donations)

print(f"total donation:{total}")
print(f"average donation: {avg}")
print(f"max_person is :{max_person}")
