print("=== Cyber Security Password Checker ===")

password = input("Enter your password: ")
length = len(password)

print(f"Password Length: {length}")

if length < 8:
    print("Weak Password ")
elif 8 <= length <= 11:
    print("Medium Password ")
else:
    print("Strong Password ")
