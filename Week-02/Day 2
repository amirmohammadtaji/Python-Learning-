print(" Number Comparison Program ")

a = int(input("Enter first number: "))
b = int(input("Enter second number: "))
c = int(input("Enter third number: "))

if a < b <= c:
    print("\nCondition is True ")
    print(f"{a} < {b} <= {c}")
else:
    print("\nCondition is False ")
    print(f"{a} < {b} <= {c}")
