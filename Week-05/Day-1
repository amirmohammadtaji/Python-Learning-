import datetime
now = datetime.datetime.now()
minute = now.minute


def run_on_zoj(f):
    def wrapper():
        if minute % 2 == 0:
            f()

        else:
            print("hisss")
    return wrapper


@run_on_zoj
def say_hello():
    print("Hi!,I am hear")


@run_on_zoj
def say_bay():
    print("Bay Bay!")


say_hello()
say_bay()
