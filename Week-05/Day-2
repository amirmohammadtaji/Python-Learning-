# Description:
# A simple decorator that measures and displays
# the execution time of a function.
# Concepts Used:
# - Decorators
# - Functions
# - Wrapper Functions
# - Function Arguments
# - return
# - time module
# - range()
# - List
# ==========================================

import time


def timer(func):
    def wrapper(n):
        start = time.time()
        result = func(n)
        end = time.time()
        print("Execution time:", end - start, "seconds")
        return result
    return wrapper


@timer
def create_list(n):
    return list(range(1, n + 1))


n = int(input())

result = create_list(n)

print(result)
